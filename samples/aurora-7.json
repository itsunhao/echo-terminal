        { "keywords": ["医疗舱"], "goto": "medical" },
        { "keywords": ["生活区"], "goto": "quarters" },
        { "keywords": ["实验舱"], "goto": "lab" },
        { "keywords": ["通讯阵列"], "goto": "comms" },
        {
          "keywords": ["核心机房", "核心"],
          "branches": [
            {
              "when": {
                "and": [
                  { "item": "门禁卡（核心机房）" },
