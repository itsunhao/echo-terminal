{
  "format": 1,
  "id": "rainy-night-manor",
  "title": "雨夜山庄杀人事件",
  "genre": "破案 · 推理",
  "version": "1.0",
  "author": "孙浩",
  "description": "暴雨夜，沈公馆主人死在从内反锁的书房里。三名嫌疑人，三条线索，一场关于真相的问话。",
  "startScene": "arrival",
  "endings": ["沉冤昭雪", "信中之名", "替罪之羊", "雨夜悬案"],
  "clues": ["clue_poison", "clue_will", "clue_footprint"],
  "scenes": {
    "arrival": {
      "numbered": true,
      "enter": [
        "「暴雨，像有人在天上倒一整座湖。」",
        "你叫顾沉，市署刑警。半小时前接到报案：西郊沈公馆的主人沈万钧，被发现死在自家书房里。",
        "车灯划开雨幕，沈公馆的黑影在闪电里浮现——三层石砌小楼，像一只蹲伏的兽。",
        "门口的老门房认得你的证件，把伞塞进你手里，声音发抖：",
        "「老爷……是在书房里走的。门从里面闩着，是我们撞开的。家里就三个人，都在客厅等着。」"
      ],
      "fallback": [
        { "text": "（雨声太大了。先决定：正门进去，还是绕去后院？）", "style": "dim" }
      ],
      "actions": [
        {
          "label": "推开正门，直接进入大厅",
          "keywords": ["正门", "直接", "大厅"],
          "lines": [
            "你推开沉重的正门。暖光、旧木和一丝药味，一起涌了出来。"
          ],
          "goto": "hall"
        },
        {
          "label": "绕到后院，看看外围再进去",
          "keywords": ["后院", "外围", "绕"],
          "lines": [
            "你绕到后院。雨水顺着屋檐挂成珠帘。",
            "书房的窗下是一片花坛，此刻被浇得稀烂——泥地上，似乎留着几个浅浅的印子。",
            "（记在心里。你转身回到正门。）"
          ],
          "effects": [{ "setFlag": "noticed_prints" }],
          "goto": "hall"
        }
      ]
    },
    "hall": {
      "enter": {
        "branches": [
          {
            "when": { "notFlag": "visited_hall" },
            "lines": [
              "—— 大厅 ——",
              "挑高的客厅里点着壁灯。墙上挂满字画，长桌上摆着冷掉的茶。",
              "三个人分坐三处，谁也不看谁：老管家陈伯垂手立在壁炉边；侄女沈露陷在沙发里绞着手帕；家庭医生周砚坐在窗侧，膝上摊着一本书，却没翻页。",
              "见你进来，三双眼睛同时抬起。"
            ],
            "effects": [{ "setFlag": "visited_hall" }]
          }
        ],
        "lines": [
          "—— 大厅 ——",
          "壁灯昏黄。三个人仍各自守着原来的位置，像三尊沉默的雕像。"
        ]
      },
      "fallback": [
        { "text": "（大厅里，你可以：前往 书房 / 厨房 / 花园 / 客房 / 走廊；查看现场后，可以 前往客厅 问话。）", "style": "dim" }
      ],
      "actions": [
        {
          "keywords": ["前往书房", "书房", "现场"],
          "goto": "study"
        },
        {
          "keywords": ["前往厨房", "厨房"],
          "goto": "kitchen"
        },
        {
          "keywords": ["前往花园", "花园", "后院"],
          "goto": "garden"
        },
        {
          "keywords": ["前往客房", "客房"],
          "goto": "guests"
        },
        {
          "keywords": ["前往走廊", "走廊"],
          "goto": "corridor"
        },
        {
          "keywords": ["前往客厅", "问话", "讯问", "询问他们"],
          "when": { "flag": "visited_study" },
          "branches": [
            {
              "when": { "notFlag": "visited_parlor" },
              "lines": [
                "你拍了拍手：「三位，请到隔壁客厅坐。一个一个来。」",
                "椅脚拖过地板的声音，在雨夜里格外清楚。"
              ],
              "goto": "parlor"
            }
          ],
          "goto": "parlor"
        },
        {
          "keywords": ["环顾", "观察大厅"],
          "branches": [
            {
              "when": { "notFlag": "hall_looked" },
              "lines": [
                "你慢慢环顾大厅：伞架上三把湿伞，只有最旧的那把在滴水——门房说，今晚没人出过正门。",
                "壁炉边的地毯干干净净。可你注意到，陈伯的鞋边沾着一圈新鲜的泥。",
                "（书房在西翼。厨房在后。客房在二楼。花园的门，在走廊尽头。）"
              ],
              "effects": [{ "setFlag": "hall_looked" }]
            },
            {
              "lines": [
                "还是那三双眼睛，还是那场雨。该看的，都该在现场和证据里。"
              ]
            }
          ]
        }
      ]
    },
    "study": {
      "enter": {
        "branches": [
          {
            "when": { "notFlag": "visited_study" },
            "lines": [
              "—— 书房 · 案发现场 ——",
              "门是被撞开的，木闩断成两截，碎片还躺在地毯上。",
              "沈万钧伏在书桌上，右手前伸，像要去够什么。桌上摊着一本账册，一盏凉透的茶，和一只喝空了的药碗。",
              "法医初步判断：死亡时间今晚十点前后，心骤停。没有外伤。",
              "房间从内反锁。唯一的窗，却虚掩着，窗栓上有一道很新的金属划痕。"
            ],
            "effects": [{ "setFlag": "visited_study" }]
          }
        ],
        "lines": [
          "—— 书房 ——",
          "尸体已被白布覆上。断闩、空药碗、虚掩的窗，都还在原来的位置。"
        ]
      },
      "fallback": [
        { "text": "（书房里，你可以：查看书桌 / 查看窗户 / 查看壁炉；或 返回大厅。）", "style": "dim" }
      ],
      "actions": [
        {
          "keywords": ["查看书桌", "书桌", "账册", "抽屉"],
          "branches": [
            {
              "when": { "notFlag": "clue_will" },
              "lines": [
                "你翻开书桌的抽屉。账册底下，压着两份文书。",
                "一份是旧遗嘱：遗产由侄女沈露继承，按月支付管家陈伯养老金，另有一笔「周砚医师专项诊金」，数额大得刺眼。",
                "另一份是新遗嘱，落款日期是上周。上面只有一处改动——「周砚医师专项诊金」整条被墨笔划去，旁边是沈万钧的亲笔批注：",
                "「查有所获，不再姑息。」",
                "（获得线索：遗嘱改动）"
              ],
              "effects": [{ "setFlag": "clue_will" }]
            },
            {
              "lines": [
                "旧遗嘱，新遗嘱。「查有所获，不再姑息。」八个字，笔画很重。"
              ]
            }
          ]
        },
        {
          "keywords": ["查看窗户", "窗户", "窗栓"],
          "branches": [
            {
              "when": { "notFlag": "window_checked" },
              "lines": [
                "你推开虚掩的窗。窗栓上的划痕很新——是从外面用薄铁片拨开的。",
                "窗台外侧湿漉漉的，留下一小片泥渍；正下方，是后院的花坛。",
                "门从里面闩着，窗却被人从外面开过。有人不想走门。"
              ],
              "effects": [{ "setFlag": "window_checked" }]
            },
            {
              "lines": [
                "窗外的雨还在下。花坛里的泥，被浇得越来越烂。"
              ]
            }
          ]
        },
        {
          "keywords": ["查看壁炉", "壁炉", "灰烬"],
          "branches": [
            {
              "when": { "notItem": "烧毁的信残角" },
              "lines": [
                "壁炉里有新烧过的纸灰。你蹲下身，用火钳小心翻动。",
                "灰烬边缘，剩下一小片没烧尽的信纸残角，字迹被燎去大半，只认得出几个字：",
                "「……专项诊金的账，我手里都有……明日必须当面……」",
                "落款处只剩一个烧焦的角。",
                "（获得物品：烧毁的信残角）"
              ],
              "effects": [{ "addItem": "烧毁的信残角" }]
            },
            {
              "lines": [
                "灰烬已经凉透了。写信的人想让它彻底消失，火却打了个盹。"
              ]
            }
          ]
        },
        {
          "keywords": ["返回大厅", "返回", "回大厅"],
          "goto": "hall"
        }
      ]
    },
    "kitchen": {
